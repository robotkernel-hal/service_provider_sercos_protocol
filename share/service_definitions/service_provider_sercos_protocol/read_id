services:
  service_provider_sercos_protocol/read_id:
    request:
      idn: { type: uint16_t }
      elements: { type: uint8_t }
    response:
      structure: { type: uint16_t }
      name: { type: string }
      unit: { type: string }
      attr: { type: uint32_t }
      min_value: { type: string }
      max_value: { type: string }
      value: { type: string }
      error_message: { type: string, default: "no error" }

